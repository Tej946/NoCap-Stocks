# ==============================================================================
# NoCap Stocks — Environment Configuration Template (.env.example)
# "No fake predictions. Just historical data."
# Copy this file to .env and adjust variables as needed:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Flask Backend Server Configuration
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=5000
FLASK_ENV=development
FLASK_DEBUG=True

# ------------------------------------------------------------------------------
# Frontend & CORS Configuration
# ------------------------------------------------------------------------------
FRONTEND_PORT=8000
FRONTEND_URL=http://localhost:8000
API_BASE_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# Stock Analysis Engine Defaults
# ------------------------------------------------------------------------------
DEFAULT_TICKER=AAPL
DEFAULT_DROP_THRESHOLD=10.0
DEFAULT_WINDOW_DAYS=5
DEFAULT_YEARS=10
MAX_HISTORICAL_YEARS=50
DATA_SOURCE=yfinance
CACHE_TTL_SECONDS=3600

# ------------------------------------------------------------------------------
# NoCap AI Intelligence & Credits System
# ------------------------------------------------------------------------------
INITIAL_AI_CREDITS=500
MAX_AI_CREDITS=500
ANALYSIS_CREDIT_COST=25
EXPLAIN_CREDIT_COST=5
COMPARE_CREDIT_COST=20

# ------------------------------------------------------------------------------
# AI Provider Configuration (Production: Gemini API | Local: Ollama / Gemma 3)
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=your_gemini_api_key_here
GEMMA_MODEL=gemma3:4b
OLLAMA_BASE_URL=http://localhost:11434
